# Copy this file to .env and never commit .env. These values talk to fakehub.
# Step 5 replaces the first four lines with your GitHub OAuth app and GitHub itself.
CLIENT_ID=fakehub-client
CLIENT_SECRET=fakehub-secret-not-a-real-secret
OAUTH_BASE=http://127.0.0.1:9000
API_BASE=http://127.0.0.1:9000
REDIRECT_URI=http://127.0.0.1:8000/callback
